# ============================================================
# QuantPilot 单机部署环境变量
#   cp .env.example .env   然后填写真实值
#   .env 已被 .gitignore 忽略，切勿提交真实凭据
#   docker compose 会把这里的变量插值进 docker-compose.yml
# ============================================================

# ---------- 必填 (缺失时 compose 拒绝启动) ----------

# 远程阿里云 RDS MySQL 连接串 (backend 容器使用; 驱动统一 aiomysql)
DATABASE_URL=mysql+aiomysql://user:password@your-rds-host.mysql.rds.aliyuncs.com:3306/stockdb?charset=utf8mb4

# JWT 签名密钥: 必须强随机, 生成命令 openssl rand -hex 32
JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32

# ---------- 选填 ----------

# 国信证券限免数据源 API Key (可留空)
GS_API_KEY=

# 国信数据源地址 (backend 代码有同名默认值, 一般无需修改)
GS_API_BASE=https://dgzt.guosen.com.cn/skills

# Cookie Secure 标记: 切换 HTTPS 部署后才置 true;
# http 阶段开启会导致 Safari 拒绝回传 Secure cookie, 表现为无法登录
COOKIE_SECURE=false

# 跨域允许的前端 origin (逗号分隔)。
# 仅 Vite 直连后端开发 (localhost:5173) 需要; nginx 反代的单机部署留空即可
CORS_ORIGINS=

# 仅 local-db profile (可选的本地 MySQL 容器) 使用; 直连 RDS 时随便填占位值即可
# 本地库启用后 DATABASE_URL 形如:
#   mysql+aiomysql://root:<该密码>@mysql:3306/quantpilot?charset=utf8mb4
MYSQL_ROOT_PASSWORD=local-only-placeholder
