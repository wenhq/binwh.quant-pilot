# ============================================================================
# QuantPilot 后端配置模板
# 复制为 .env 后按需修改。.env 含真实凭据，绝不能提交到版本库。
# pydantic-settings 优先级: 环境变量 > .env 文件 > 代码默认值
# ============================================================================

# --- 数据库 -----------------------------------------------------------------
# SQLAlchemy async 连接串 (MySQL, aiomysql 驱动)
DATABASE_URL=mysql+aiomysql://user:password@host:3306/stockdb

# --- 服务监听 ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- JWT / Cookie 认证 --------------------------------------------------------
# 必须替换为强随机值！生成示例:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# 泄露该值 = 任何人可伪造登录态；每个环境独立生成，切勿复用或提交真实值。
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
# access token 有效期（分钟）/ refresh token 有效期（天）
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Cookie Secure 标记：生产环境（HTTPS）必须为 true，否则浏览器拒绝设置/回传 cookie；
# 本地 http 开发用 false。
COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# 允许跨域携带凭证的前端 origin，多个用逗号分隔；
# allow_credentials=True 时不能使用通配符 *。
CORS_ORIGINS=http://localhost:5173

# --- 国信证券数据源（限免接口，可能失效）---------------------------------------
GS_API_KEY=
GS_API_BASE=https://dgzt.guosen.com.cn/skills

# --- 批量导入限流（避免被 akshare/国信 封 IP）----------------------------------
IMPORT_RATE_SECONDS=2.0
IMPORT_CONCURRENCY=2
# 连续失败 N 次后熔断该数据源
IMPORT_CIRCUIT_THRESHOLD=5
# 熔断后冷却秒数
IMPORT_CIRCUIT_COOLDOWN=300.0

# --- market_regime ML 超参 ----------------------------------------------------
REGIME_N_COMPONENTS=3
REGIME_PCA_VARIANCE=0.95
REGIME_VOL_SPAN=21
# 复杂类型按 JSON 数组格式书写
REGIME_RETURN_WINDOWS=[5,21,63]
REGIME_RANDOM_STATE=42

# --- 定时行情同步（上海时间）---------------------------------------------------
MARKET_SYNC_HOUR=15
MARKET_SYNC_MINUTE=5
# 同步失败后的重试间隔（分钟）
MARKET_SYNC_RETRY_MINUTES=30
